{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "boostrack-multiplayer",
  "main": "index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RaceRoom" },
      { "name": "QUEUES", "class_name": "MatchQueue" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaceRoom", "MatchQueue"] },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
